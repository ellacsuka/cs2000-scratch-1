use context dcic2024

overlay(circle(20, "solid", "blue"),
  rectangle(80, 50, "solid", "yellow"))

above(rectangle(100, 60, "solid", "green"), rectangle(80, 50, "solid", "purple"))

rectangle(100, 20, "solid", "red")
rectangle(20, 100, "solid", "red")

regular-polygon(40, 8, "solid", "red")
regular-polygon(40, 8, "outline", "red")